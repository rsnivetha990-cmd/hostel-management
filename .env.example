# ========================================================
# SMART HOSTEL MANAGEMENT SYSTEM - CLOUD ENVIRONMENT CONFIG
# ========================================================

# Flask Settings
SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=False

# 1. Cloud Database (e.g. Neon.tech PostgreSQL or Supabase)
# Leave blank/commented out to use local SQLite (hostel.db)
# DATABASE_URL=postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Cloud Object Storage (Cloudinary)
# Free 25GB media storage & CDN: https://cloudinary.com/console
# If not configured, uploads are saved locally in static/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
